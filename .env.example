# Copy to .env, then fill in the two Supabase values. Server-side only.
# Supabase Dashboard > Settings > API Keys. Use a secret key, not publishable.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# Optional legacy fallback: use only if your project still uses service_role JWTs.
SUPABASE_SERVICE_ROLE_KEY=

# Exact public origin on hosting, e.g. https://lyrionfitness.com (no trailing path).
# Leave blank locally. Restart npm start after editing this file.
SITE_URL=
HOST=127.0.0.1
PORT=4173
