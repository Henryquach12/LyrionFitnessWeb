# Server only. Copy to .env in the repository root, next to public/.
# Existing hosting environment variables take precedence over this file.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
# Optional legacy key; leave empty when using SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
# Exact public origin when hosted. Leave empty for local development.
SITE_URL=
HOST=127.0.0.1
PORT=4173
